# =====================================================================
# SentriEnv Configuration & Gmail SMTP Credentials (EXAMPLE TEMPLATE)
# Smart India Hackathon 2026 | Disaster Management Command Platform
# =====================================================================

# Flask Secret Key for Session Security
SECRET_KEY=sentrienv-ultra-secure-key-2026-prod

# SentriEnv Hardware / Ingestion REST API Key
SENTRIENV_API_KEY=sentrienv-dev-api-key

# ---------------------------------------------------------------------
# Gmail SMTP Configuration for Email OTP Authentication
# ---------------------------------------------------------------------
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True

# Replace with your actual Gmail address:
MAIL_USERNAME=your_gmail_address@gmail.com

# Replace with your 16-character Google App Password (NOT your regular password):
# Generate from: Google Account > Security > 2-Step Verification > App passwords
MAIL_PASSWORD=your_16_character_google_app_password

# Default email sender display header
MAIL_DEFAULT_SENDER=your_gmail_address@gmail.com

# ---------------------------------------------------------------------
# Emergency Carrier SMS (Optional - Twilio / MSG91)
# ---------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
MSG91_AUTH_KEY=
SMS_COOLDOWN_SECONDS=300
